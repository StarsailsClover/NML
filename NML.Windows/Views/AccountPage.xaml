<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NML.Windows.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="账户管理" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBlock Text="微软 | 离线 | 第三方" Opacity="0.6"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button x:Name="AddMicrosoftButton" Click="AddMicrosoftButton_Click" Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Contact"/>
                    <TextBlock Text="添加微软账户" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <Button x:Name="AddOfflineButton" Click="AddOfflineButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Contact2"/>
                    <TextBlock Text="添加离线账户"/>
                </StackPanel>
            </Button>

            <Button x:Name="AddThirdPartyButton" Click="AddThirdPartyButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Globe"/>
                    <TextBlock Text="添加第三方"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Account List -->
        <ListView Grid.Row="2" x:Name="AccountsList">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <SymbolIcon Grid.Column="0" Symbol="Contact" FontSize="32"/>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding PlayerName}" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding AccountType}" FontSize="12" Opacity="0.6"/>
                                <TextBlock Text="{Binding UUID}" FontSize="12" Opacity="0.4" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="选择" Click="SelectButton_Click" Style="{ThemeResource AccentButtonStyle}"/>
                            <Button Content="删除" Click="DeleteButton_Click"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
