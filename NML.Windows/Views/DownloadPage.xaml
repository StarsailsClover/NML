<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NML.Windows.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="下载管理" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBlock Text="多源并行下载 | BMCLAPI加速" Opacity="0.6"/>
        </StackPanel>

        <!-- Stats -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="下载速度" FontSize="12" Opacity="0.6"/>
                    <TextBlock x:Name="SpeedText" Text="0 MB/s" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="活跃任务" FontSize="12" Opacity="0.6"/>
                    <TextBlock x:Name="TasksText" Text="0" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="总流量" FontSize="12" Opacity="0.6"/>
                    <TextBlock x:Name="TrafficText" Text="0 GB" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tasks -->
        <ListView Grid.Row="2" x:Name="DownloadList">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Size}" VerticalAlignment="Center" Opacity="0.6"/>
                        <ProgressBar Grid.Column="2" Value="{Binding Progress}" Maximum="100"/>
                        <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" Opacity="0.6"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
