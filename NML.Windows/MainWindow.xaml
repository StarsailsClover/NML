<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NML.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NML.Windows"
    xmlns:views="using:NML.Windows.Views">

    <NavigationView x:Name="NavView"
                    PaneDisplayMode="Left"
                    IsBackEnabled="True"
                    IsBackButtonVisible="Visible"
                    SelectionChanged="NavView_SelectionChanged">
        
        <NavigationView.MenuItems>
            <NavigationViewItem Content="主页" Tag="Home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            
            <NavigationViewItem Content="下载" Tag="Download">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Download"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            
            <NavigationViewItem Content="多人游戏" Tag="Multiplayer">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="People"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            
            <NavigationViewItem Content="Mod管理" Tag="Mods">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Repair"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            
            <NavigationViewItem Content="服务器" Tag="Server">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="World"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="设置" Tag="Settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            
            <NavigationViewItem Content="账户" Tag="Account">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Contact"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" Margin="24"/>
    </NavigationView>
</Window>
