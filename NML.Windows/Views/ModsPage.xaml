<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NML.Windows.Views.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Mod管理" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBlock Text="CurseForge | Modrinth" Opacity="0.6"/>
        </StackPanel>

        <!-- Search -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="SearchBox" PlaceholderText="搜索Mod..." Width="300"/>
            <Button x:Name="SearchButton" Click="SearchButton_Click">
                <SymbolIcon Symbol="Find"/>
            </Button>
            <Button x:Name="InstallButton" Click="InstallButton_Click" Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Download"/>
                    <TextBlock Text="安装Mod"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Mod List -->
        <ListView Grid.Row="2" x:Name="ModsList">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" Click="ModToggle_Click"/>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Version}" FontSize="12" Opacity="0.6"/>
                            <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="更新" Click="UpdateButton_Click" Style="{ThemeResource AccentButtonStyle}"/>
                            <Button Content="删除" Click="DeleteButton_Click"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
