<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NML.Windows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="24" MaxWidth="800">
            <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}"/>

            <!-- General -->
            <Expander Header="常规设置" IsExpanded="True">
                <StackPanel Spacing="16" Margin="0,16,0,0">
                    <TextBox x:Name="GamePathBox" Header="游戏目录" IsReadOnly="True"/>
                    <Button Content="浏览..." Click="BrowsePath_Click"/>

                    <Slider x:Name="MaxMemorySlider" Header="最大内存 (MB)" Minimum="1024" Maximum="32768" StepFrequency="512" Value="4096"/>
                    <Slider x:Name="MinMemorySlider" Header="最小内存 (MB)" Minimum="512" Maximum="8192" StepFrequency="256" Value="512"/>
                </StackPanel>
            </Expander>

            <!-- Download -->
            <Expander Header="下载设置">
                <StackPanel Spacing="16" Margin="0,16,0,0">
                    <Slider x:Name="MaxDownloadsSlider" Header="最大并行下载数" Minimum="1" Maximum="16" StepFrequency="1" Value="8"/>
                    <ToggleSwitch x:Name="UseMirrorToggle" Header="使用镜像加速 (BMCLAPI)" IsOn="True"/>
                    <ToggleSwitch x:Name="AutoResumeToggle" Header="断点续传" IsOn="True"/>
                </StackPanel>
            </Expander>

            <!-- P2P -->
            <Expander Header="P2P联机设置">
                <StackPanel Spacing="16" Margin="0,16,0,0">
                    <ToggleSwitch x:Name="EnableP2PToggle" Header="启用P2P联机" IsOn="True"/>
                    <ToggleSwitch x:Name="EnableHolePunchToggle" Header="启用NAT穿透" IsOn="True"/>
                    <TextBox x:Name="NodeNameBox" Header="节点名称" PlaceholderText="MyNode"/>
                </StackPanel>
            </Expander>

            <!-- Optimization -->
            <Expander Header="性能优化 (MCJEBooster)">
                <StackPanel Spacing="16" Margin="0,16,0,0">
                    <ToggleSwitch x:Name="EnableBoosterToggle" Header="启用性能优化" IsOn="True"/>
                    <ToggleSwitch x:Name="AutoOptimizeToggle" Header="自动为支持的版本启用" IsOn="True"/>
                    <ComboBox x:Name="WorkerCountBox" Header="优化工作线程数">
                        <ComboBoxItem Content="自动" IsSelected="True"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="8"/>
                    </ComboBox>
                </StackPanel>
            </Expander>

            <!-- About -->
            <Expander Header="关于">
                <StackPanel Spacing="8" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <SymbolIcon Symbol="Video" FontSize="48"/>
                        <StackPanel>
                            <TextBlock Text="NML" FontWeight="SemiBold" FontSize="24"/>
                            <TextBlock Text="版本 0.1.0-alpha" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="N0th1ngness Minecraft Launcher" Opacity="0.8"/>
                    <TextBlock Text="Core Developer: StarsailsClover" Opacity="0.6"/>
                    <TextBlock Text="Team: BlockConnect" Opacity="0.6"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
